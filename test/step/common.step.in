ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('SolveSpace STEP dependency proof; tetrahedron and disconnected attribute probes'),'2;1');
FILE_NAME('common.step','2026-11-07T00:00:00',('SolveSpace'),('SolveSpace'),'dependency proof','','');
FILE_SCHEMA(('@SCHEMA@'));
ENDSEC;
DATA;
/* Four vertices of a tetrahedron. */
#1=CARTESIAN_POINT('origin''s name',(0.,0.,0.));
#2=CARTESIAN_POINT('',(10.,0.,0.));
#3=CARTESIAN_POINT('',(0.,10.,0.));
#4=CARTESIAN_POINT('',(0.,0.,10.));
#11=VERTEX_POINT('',#1);
#12=VERTEX_POINT('',#2);
#13=VERTEX_POINT('',#3);
#14=VERTEX_POINT('',#4);
/* Six directed edges: 01, 12, 20, 03, 13, 23. */
#21=DIRECTION('',(1.,0.,0.));
#22=DIRECTION('',(-1.,1.,0.));
#23=DIRECTION('',(0.,-1.,0.));
#24=DIRECTION('',(0.,0.,1.));
#25=DIRECTION('',(-1.,0.,1.));
#26=DIRECTION('',(0.,-1.,1.));
#31=VECTOR('',#21,1.);
#32=VECTOR('',#22,1.);
#33=VECTOR('',#23,1.);
#34=VECTOR('',#24,1.);
#35=VECTOR('',#25,1.);
#36=VECTOR('',#26,1.);
#41=LINE('',#1,#31);
#42=LINE('',#2,#32);
#43=LINE('',#3,#33);
#44=LINE('',#1,#34);
#45=LINE('',#2,#35);
#46=LINE('',#3,#36);
#51=EDGE_CURVE('',#11,#12,#41,.T.);
#52=EDGE_CURVE('',#12,#13,#42,.T.);
#53=EDGE_CURVE('',#13,#11,#43,.T.);
#54=EDGE_CURVE('',#11,#14,#44,.T.);
#55=EDGE_CURVE('',#12,#14,#45,.T.);
#56=EDGE_CURVE('',#13,#14,#46,.T.);
#61=ORIENTED_EDGE('',*,*,#53,.F.);
#62=ORIENTED_EDGE('',*,*,#52,.F.);
#63=ORIENTED_EDGE('',*,*,#51,.F.);
#64=ORIENTED_EDGE('',*,*,#51,.T.);
#65=ORIENTED_EDGE('',*,*,#55,.T.);
#66=ORIENTED_EDGE('',*,*,#54,.F.);
#67=ORIENTED_EDGE('',*,*,#54,.T.);
#68=ORIENTED_EDGE('',*,*,#56,.F.);
#69=ORIENTED_EDGE('',*,*,#53,.T.);
#70=ORIENTED_EDGE('',*,*,#52,.T.);
#71=ORIENTED_EDGE('',*,*,#56,.T.);
#72=ORIENTED_EDGE('',*,*,#55,.F.);
#81=EDGE_LOOP('',(#61,#62,#63));
#82=EDGE_LOOP('',(#64,#65,#66));
#83=EDGE_LOOP('',(#67,#68,#69));
#84=EDGE_LOOP('',(#70,#71,#72));
#91=FACE_OUTER_BOUND('',#81,.T.);
#92=FACE_OUTER_BOUND('',#82,.T.);
#93=FACE_OUTER_BOUND('',#83,.T.);
#94=FACE_OUTER_BOUND('',#84,.T.);
#101=DIRECTION('',(0.,0.,-1.));
#102=DIRECTION('',(0.,-1.,0.));
#103=DIRECTION('',(-1.,0.,0.));
#104=DIRECTION('',(1.,1.,1.));
#111=AXIS2_PLACEMENT_3D('',#1,#101,#21);
#112=AXIS2_PLACEMENT_3D('',#1,#102,#21);
#113=AXIS2_PLACEMENT_3D('',#1,#103,#24);
#114=AXIS2_PLACEMENT_3D('',#2,#104,#22);
#121=PLANE('',#111);
#122=PLANE('',#112);
#123=PLANE('',#113);
#124=PLANE('',#114);
#131=ADVANCED_FACE('',(#91),#121,.T.);
#132=ADVANCED_FACE('',(#92),#122,.T.);
#133=ADVANCED_FACE('',(#93),#123,.T.);
#134=ADVANCED_FACE('',(#94),#124,.T.);
#140=CLOSED_SHELL('',(#131,#132,#133,#134));
#141=MANIFOLD_SOLID_BREP('tetrahedron',#140);
/* Complex units, a typed SELECT measure, and a complex representation context. */
#151=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#152=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#153=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#154=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#163))GLOBAL_UNIT_ASSIGNED_CONTEXT((#151,#152,#153))REPRESENTATION_CONTEXT('3D',''));
#155=ADVANCED_BREP_SHAPE_REPRESENTATION('',(#141),#154);
#160=DIMENSIONAL_EXPONENTS(1.,0.,0.,0.,0.,0.,0.);
#161=LENGTH_MEASURE_WITH_UNIT(LENGTH_MEASURE(25.4),#151);
/* AP214 E3 derives the dimensions; the pinned AP203/AP242 schemas do not. */
#162=(CONVERSION_BASED_UNIT('INCH',#161)LENGTH_UNIT()NAMED_UNIT(@CONVERSION_DIMENSIONS@));
#163=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.E-6),#151,'distance_accuracy_value','');
/* Disconnected curve/surface probes, including nested aggregates. */
#170=(BOUNDED_CURVE()B_SPLINE_CURVE(2,(#1,#2,#3),.UNSPECIFIED.,.F.,.F.)B_SPLINE_CURVE_WITH_KNOTS((3,3),(0.,1.),.UNSPECIFIED.)CURVE()GEOMETRIC_REPRESENTATION_ITEM()RATIONAL_B_SPLINE_CURVE((1.,0.7071067811865476,1.))REPRESENTATION_ITEM('arc'));
#171=(BOUNDED_SURFACE()B_SPLINE_SURFACE(1,1,((#1,#2),(#3,#4)),.UNSPECIFIED.,.F.,.F.,.F.)B_SPLINE_SURFACE_WITH_KNOTS((2,2),(2,2),(0.,1.),(0.,1.),.UNSPECIFIED.)GEOMETRIC_REPRESENTATION_ITEM()RATIONAL_B_SPLINE_SURFACE(((1.,0.5),(2.,1.)))REPRESENTATION_ITEM('surface')SURFACE());
/* Topology-only cavity reference probe, NOT a geometrically valid void. No
   geometry/EXPRESS-rule validation is claimed by this dependency proof. */
#180=ORIENTED_CLOSED_SHELL('',*,#140,.F.);
#181=BREP_WITH_VOIDS('cavity reference probe',#140,(#180));
/* Retain schema-valid geometry regardless of future converter support. */
#182=TOROIDAL_SURFACE('',#111,10.,2.);
ENDSEC;
END-ISO-10303-21;
