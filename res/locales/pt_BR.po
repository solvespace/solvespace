msgstr "Formato inválido: especifique a cor como r, g, b"

#: confscreen.cpp:446
msgid ""
"The perspective factor will have no effect until you enable View -> Use Perspective Projection."
msgstr ""
"O fator de perspectiva não terá efeito até que você ative Vista -> Usar projeção em perspectiva."

#: confscreen.cpp:464 confscreen.cpp:474
#, c-format
msgid "Specify between 0 and %d digits after the decimal."
msgstr "Especifique entre 0 e %d dígitos após a vírgula decimal."

#: confscreen.cpp:486
msgid "Export scale must not be zero!"
msgstr "A escala de exportação não pode ser zero!"

#: confscreen.cpp:498
msgid "Cutter radius offset must not be negative!"
msgstr "A compensação do raio da fresa não pode ser negativa!"

#: confscreen.cpp:557
msgid "Bad value: autosave interval should be positive"
msgstr "Valor inválido: o intervalo de salvamento automático deve ser positivo"

#: confscreen.cpp:560
msgid "Bad format: specify interval in integral minutes"
msgstr "Formato inválido: especifique o intervalo em minutos inteiros"

